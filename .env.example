# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=your-super-secret-jwt-key-here

# Endpoints
WESTEND_RPC_URLS=wss://westend-rpc.polkadot.io,wss://westend-rpc.dwellir.com
ASSETHUB_RPC_URLS=wss://westend-asset-hub-rpc.polkadot.io

# Encryption
ENCRYPTION_KEY=32-character-aes-key-1234567890

# Twilio
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+15551234567

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Nani Alerts" <you@gmail.com>


# Deployment platform (auto detected)
RAILWAY_ENVIRONMENT_NAME=production
# RENDER_INSTANCE_ID=...
# FLY_APP_NAME=nani-prod
# HEROKU_DYNO=...
# VERCEL=1
# NETLIFY=1

ADMIN_GUI_ENABLED=true                 # Enable AceBase Admin GUI
ADMIN_GUI_PORT=3001                    # Admin GUI port
ADMIN_GUI_USERNAME=admin               # Admin GUI username
ADMIN_GUI_PASSWORD=supersecretpassword # Admin GUI password

# Rate limiting
# (defaults are fine)