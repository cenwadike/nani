# ============================================
# NANI - CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# NODE.JS MEMORY CONFIGURATION
# ============================================
# Adjust based on your available RAM

# Maximum heap size in MB (recommended: 6144-8192 for production)
# Railway/Render: Use 6144 (6GB) for 8GB instances
# Docker/VPS: Adjust based on available memory
NODE_OPTIONS=--max-old-space-size=6144 --expose-gc --gc-interval=100 --optimize-for-size

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
PORT=3000
GIT_COMMIT=

# Admin Credentials (CHANGE THESE IMMEDIATELY!)
ADMIN_EMAIL=admin@nani.dev
ADMIN_PASSWORD=your_very_secure_password_here

MONGODB_URI=
MONGODB_NAME=

# Force single-process mode (recommended for Railway/PaaS)
# Set to 'false' for cluster mode on dedicated servers
FORCE_SINGLE=true

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Generate secure keys:

# JWT Secrets (min 32 characters)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# Encryption Key for AES-256-GCM (exactly 32 characters)
# openssl rand -base64 32
ENCRYPTION_KEY=

# Admin IP Whitelist (comma-separated IPs)
ADMIN_IP_WHITELIST=
# ============================================
# EVENT QUEUE CONFIGURATION
# ============================================
# Controls memory usage and event processing

# Maximum events in queue (default: 10000)
# Lower = less memory, higher = handles more bursts
# Recommended: 5000-15000 depending on RAM
QUEUE_MAX_SIZE=10000

# Events processed per batch (default: 100)
# Higher = faster processing but more memory pressure
# Lower = slower but more stable
# Recommended: 50-200
QUEUE_BATCH_SIZE=100

# Retry attempts for failed events (default: 3)
QUEUE_MAX_RETRIES=3

# Deduplication window in milliseconds (default: 60000 = 1 minute)
# Events with same hash within this window are dropped as duplicates
# Higher = more deduplication, more memory for cache
QUEUE_DEDUP_WINDOW=60000

# Delay between batches in milliseconds (default: 100)
# Higher = less CPU usage, lower = faster processing
# Recommended: 50-200
QUEUE_PROCESSING_DELAY=100

# ============================================
# CHAIN CONFIGURATION (Legacy - prefer chains.json)
# ============================================
# Comma-separated RPC endpoints (with failover)
POLKADOT_RELAY_RPC_URLS=
KUSAMA_RELAY_RPC_URLS=
ASSETHUB_POLKADOT_RPC_URLS=wss://polkadot-asset-hub-rpc.polkadot.io
ASSETHUB_KUSAMA_RPC_URLS=wss://kusama-asset-hub-rpc.polkadot.io
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL= 
NEAR_RPC_URL=
SOLANA_RPC_URL=
SUI_RPC_URL=
COSMOS_HUB_RPC_URL=
BITCOIN_RPC_URL=

# ============================================
# AI INTEGRATIONS
# ============================================

# Hugging Face API Token (for analytics features)
HF_TOKEN=your_huggingface_token_here

# ============================================
# NOTIFICATION CHANNELS
# ============================================

# --- Twilio SMS ---
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# --- Discord Webhook ---
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_url

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cenwadike@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Nani Alert <cenwadike@gmail.com>"

# ============================================
# ADMIN GUI (Optional - Development Only)
# ============================================
# Web-based database viewer

ADMIN_GUI_ENABLED=false
ADMIN_GUI_PORT=3001
ADMIN_GUI_USERNAME=admin
ADMIN_GUI_PASSWORD=your_secure_admin_password

# ============================================
# DEPLOYMENT-SPECIFIC SETTINGS
# ============================================

# --- Railway ---
# Railway auto-sets these, but you can override:
RAILWAY_ENVIRONMENT_NAME=production
# PORT=3000 (auto-assigned)

# --- Docker ---
# Set in docker-compose.yml or docker run command

# --- Kubernetes ---
# Set via ConfigMap and Secrets

# ============================================
# MONITORING & LOGGING
# ============================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed memory profiling (development only)
# Adds trace-gc logs - very verbose!
# NODE_OPTIONS="$NODE_OPTIONS --trace-gc"

# ============================================
# RATE LIMITING
# ============================================
# Global rate limit for API endpoints

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ============================================
# MONETIZATION SETTINGS
# ============================================
# Global monetization settings

STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ACCELERATOR=

X402_EVM_RECIPIENT=
X402_SOLANA_RECIPIENT=

# ============================================
# ALERTING SETTINGS
# ============================================

SENTRY_DSN=
SLACK_ALERT_WEBHOOK=
PAGERDUTY_INTEGRATION_KEY=

# ============================================
# NOTES & RECOMMENDATIONS
# ============================================

# MEMORY SIZING GUIDE:
# - 4GB RAM: QUEUE_MAX_SIZE=5000, BATCH_SIZE=50, max-old-space-size=3072
# - 8GB RAM: QUEUE_MAX_SIZE=10000, BATCH_SIZE=100, max-old-space-size=6144
# - 16GB RAM: QUEUE_MAX_SIZE=20000, BATCH_SIZE=200, max-old-space-size=12288

# BATCH SIZE TUNING:
# - Low traffic (< 100 events/min): BATCH_SIZE=50
# - Medium traffic (100-500 events/min): BATCH_SIZE=100
# - High traffic (> 500 events/min): BATCH_SIZE=200

# DEDUPLICATION:
# - Longer window = more memory used for cache
# - Shorter window = potential duplicate processing
# - 60 seconds is optimal for most use cases

# PROCESSING DELAY:
# - 50ms: Maximum throughput (high CPU usage)
# - 100ms: Balanced (recommended for production)
# - 200ms: Conservative (low CPU, slower processing)

# SECURITY:
# - NEVER commit .env to git
# - Rotate JWT_SECRET and ENCRYPTION_KEY monthly
# - Use different keys for dev/staging/production
# - Store secrets in Railway/Render secret management

# MONITORING:
# - Check /health/health for overall status
# - Check /health/memory for memory metrics
# - Check /health/queue for queue statistics
# - Use POST /health/gc to manually trigger garbage collection

# TROUBLESHOOTING:
# - "Heap out of memory": Increase max-old-space-size
# - "Queue full": Increase QUEUE_MAX_SIZE or reduce BATCH_SIZE
# - "High CPU": Increase QUEUE_PROCESSING_DELAY
# - "Slow processing": Decrease QUEUE_PROCESSING_DELAY or increase BATCH_SIZE
