{
  "name": "nani",
  "version": "0.1.0",
  "author": "Kombi",
  "license": "MIT",
  "description": "nani - A high-performance event backend for Blockchains.",
  "main": "dist/src/entrypoint.js",
  "scripts": {
    "build": "tsc && cp swagger.yaml dist/swagger.yaml",
    "start": "node dist/src/entrypoint.js",
    "dev": "ts-node-dev --respawn --transpile-only src/entrypoint.ts",
    "dev:cluster": "FORCE_CLUSTER=true ts-node-dev src/entrypoint.ts",
    "dev:single": "FORCE_SINGLE=true ts-node-dev --respawn --transpile-only src/entrypoint.ts",
    "db:admin": "node -e \"import('./dist/utils/storage.js').then(m => m.startAdminGui(3001, {username:'admin', password:'nani2025'}))\"",
    "db:admin:open": "npm run db:admin -- --open",
    "db:reset": "rm -rf /tmp/nani-data && echo 'DB wiped – restart app'",
    "test": "jest"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.5",
    "@mysten/sui": "^1.45.2",
    "@polkadot/api": "^10.11.1",
    "@polkadot/keyring": "^12.3.1",
    "@polkadot/util": "^12.3.1",
    "@sentry/node": "^10.30.0",
    "@sentry/profiling-node": "^10.30.0",
    "@solana/web3.js": "^1.98.4",
    "@types/nodemailer": "^7.0.3",
    "acebase": "^1.22.2",
    "acebase-server": "^1.19.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "bech32": "^2.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.15.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "near-api-js": "^6.5.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "stripe": "^20.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^4.19.0",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "workerpool": "^9.3.4",
    "ws": "^8.18.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.1",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
